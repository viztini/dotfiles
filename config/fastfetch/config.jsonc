//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  OS
//
//  by Bina


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "gentoo", // search for logos: fastfetch --list-logos or --print-logos
        "color": { "1": "magenta", "2": "white" },
        "padding": {
	        "top": 1,
	        "left": 2
	},
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",
        {
            "type": "os",
            "key": "os    ",
            "format": "Gentoo Linux {arch}",
        },
        {
            "type": "host",
            "key": "host  ",
            "format": "ThinkPad X1 Gen 9 Carbon",
        },
        {   "type": "wm",
            "key" : "de    ",
        },
        {
            "type": "packages",
            "format": "1337 (portage)",
            "key": "pkgs  ", 
        },
        {   "type": "shell",
            "key": "shell ",
        },
        {
            "type": "command",
            "key": "kernel",
            "text": "echo \"Linux $(uname -r | sed -E 's/-[0-9]+\\.fc[0-9]+\\.[a-z0-9_]*$/-gentoo/') $(uname -m)\"",
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime",
        },
        {
            "type": "command",
            "key": "os age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s);    days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "memory",
            "key": "memory",
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
